# Database connection URL used by SQLAlchemy.
DATABASE_URL=sqlite:///./short_url.db

# Public origin used when constructing short links (no path or trailing slash).
BASE_URL=http://localhost:8000

# Generated short-code length (4-16 characters).
SHORT_CODE_LENGTH=7

# Maximum number of attempts to allocate an unused short code.
MAX_CODE_RETRIES=5

# Maximum accepted original URL length.
MAX_URL_LENGTH=2048

# Application log level: CRITICAL, ERROR, WARNING, INFO, or DEBUG.
LOG_LEVEL=INFO
